---
import { defaultDescription, defaultTitle, personName, siteUrl } from '../../data/seo';

const personId = `${siteUrl}/#person`;
const websiteId = `${siteUrl}/#website`;

const personSchema = {
  '@type': 'Person',
  '@id': personId,
  name: personName,
  url: siteUrl,
  image: `${siteUrl}/og-image.png`,
  jobTitle: 'Desenvolvedor Frontend Sênior',
  description: defaultDescription,
  email: 'leobelini96@gmail.com',
  sameAs: ['https://www.linkedin.com/in/leobelini/', 'https://github.com/leobelini'],
  knowsAbout: [
    'React',
    'TypeScript',
    'JavaScript',
    'Vite',
    'Node.js',
    'NestJS',
    'C#',
    'Electron',
    'React Native',
    'MongoDB',
    'AWS',
    'Clean Architecture',
    'TDD',
    'RPA',
  ],
  knowsLanguage: 'pt-BR',
  alumniOf: [
    {
      '@type': 'EducationalOrganization',
      name: 'Unilins',
      description: 'Tecnólogo em Análise e Desenvolvimento',
    },
    {
      '@type': 'EducationalOrganization',
      name: 'ETEC',
      description: 'Técnico em Informática para Web',
    },
    {
      '@type': 'EducationalOrganization',
      name: 'Branas.io',
      description: 'Clean Code e Clean Architecture',
    },
  ],
  worksFor: {
    '@type': 'Organization',
    name: 'Globalsys',
    url: 'https://www.globalsys.com.br/',
  },
};

const websiteSchema = {
  '@type': 'WebSite',
  '@id': websiteId,
  name: 'Leonardo Belini | Portfolio',
  url: siteUrl,
  inLanguage: 'pt-BR',
  author: { '@id': personId },
};

const profilePageSchema = {
  '@type': 'ProfilePage',
  '@id': `${siteUrl}/#profile`,
  url: siteUrl,
  name: defaultTitle,
  description: defaultDescription,
  inLanguage: 'pt-BR',
  isPartOf: { '@id': websiteId },
  mainEntity: { '@id': personId },
};

const graph = {
  '@context': 'https://schema.org',
  '@graph': [personSchema, websiteSchema, profilePageSchema],
};
---

<script type="application/ld+json" set:html={JSON.stringify(graph)} />
